TMDB_API_KEY=your_tmdb_api_key_here
APP_SECRET=your_app_secret_here

# Optional: restrict API access to specific frontend domains (comma-separated)
# ALLOWED_ORIGINS=https://your-frontend.com,http://localhost:3000

# Optional: enable strict mode (rejects requests without valid signature token)
# STRICT_SECURITY=true

# Optional: custom port (default: 24608)
# PORT=24608

# Optional: Browser configuration (Playwright)
# BROWSER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# BROWSER_HEADLESS=true
# BROWSER_ARGS="--no-sandbox --disable-setuid-sandbox"
