# Rust API
RUST_HOST=127.0.0.1
RUST_PORT=24609
APP_SECRET=<generate with: openssl rand -hex 32>

# Node Scraper
SCRAPER_PORT=24610
SCRAPER_URL=http://127.0.0.1:24610

# Redis
REDIS_URL=redis://127.0.0.1:6379

# TMDB
TMDB_API_KEY=your_key_here

# Proxy
ENABLE_PROXY=true
SERVER_URL=http://127.0.0.1:24609
FAST_PROVIDER_DEADLINE_SECS=15
SLOW_PROVIDER_DEADLINE_SECS=45

# MovieBox
MOVIEBOX_HOST=moviebox.ph
