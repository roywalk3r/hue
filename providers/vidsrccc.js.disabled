console.log('[VidsrcCC] Module loaded!');

const axios = require('axios');
const cheerio = require('cheerio');

const BASE_URL = 'https://vidsrc.cc';

// Helper function to make HTTP requests with default headers
function makeRequest(url, options = {}) {
    const defaultHeaders = {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36',
        'Accept': 'application/json,*/*',
        'Accept-Language': 'en-US,en;q=0.5',
        'Accept-Encoding': 'gzip, deflate',
        'Connection': 'keep-alive',
        ...options.headers
    };
    
    return axios({
        url,
        method: options.method || 'GET',
        headers: defaultHeaders,
        timeout: options.timeout || 10000,
        ...options
    });
}

// Helper function to decode vidsrc.cc hash
function decodeVidsrcHash(hash) {
    try {
        // The hash might be used to construct a lightningbolt.site URL
        // Let's try to see if it can be used directly
        console.log(`[VidsrcCC] Processing hash: ${hash.substring(0, 50)}...`);
        
        // For now, return null to indicate we need a different approach
        return null;
    } catch (e) {
        console.error('[VidsrcCC] Failed to decode hash:', e.message);
        return null;
    }
}

// Helper function to extract stream URL from VidPlay
async function extractVidPlayUrl(embedUrl) {
    try {
        const response = await makeRequest(embedUrl);
        const $ = cheerio.load(response.data);
        
        // Look for video source in script tags
        const scripts = $('script').toArray();
        for (const script of scripts) {
            const scriptContent = $(script).html() || '';
            
            // Look for hls source
            const hlsMatch = scriptContent.match(/["']([^"']*\.m3u8[^"']*)["']/i);
            if (hlsMatch && hlsMatch[1]) {
                return hlsMatch[1];
            }
            
            // Look for file parameter
            const fileMatch = scriptContent.match(/file\s*:\s*["']([^"']+)["']/i);
            if (fileMatch && fileMatch[1]) {
                return fileMatch[1];
            }
        }
        
        return null;
    } catch (e) {
        console.error('[VidsrcCC] Error extracting VidPlay URL:', e.message);
        return null;
    }
}

// Helper function to extract stream URL from UpCloud
async function extractUpCloudUrl(embedUrl) {
    try {
        const response = await makeRequest(embedUrl);
        const $ = cheerio.load(response.data);
        
        // Look for video source
        const videoSource = $('source').first().attr('src');
        if (videoSource) {
            return videoSource;
        }
        
        // Check script tags for sources
        const scripts = $('script').toArray();
        for (const script of scripts) {
            const scriptContent = $(script).html() || '';
            const sourceMatch = scriptContent.match(/["']([^"']*\.m3u8[^"']*)["']/i);
            if (sourceMatch && sourceMatch[1]) {
                return sourceMatch[1];
            }
        }
        
        return null;
    } catch (e) {
        console.error('[VidsrcCC] Error extracting UpCloud URL:', e.message);
        return null;
    }
}

// Main function to get streams
async function getVidsrcStreams(tmdbId, mediaType, season, episode) {
    console.log(`[VidsrcCC] Called with tmdbId=${tmdbId}, mediaType=${mediaType}`);
    const streams = [];
    
    try {
        // Build the URL
        let url;
        if (mediaType === 'movie') {
            url = `${BASE_URL}/embed/movie/${tmdbId}`;
        } else {
            url = `${BASE_URL}/embed/tv/${tmdbId}/${season}/${episode}`;
        }
        
        console.log(`[VidsrcCC] Fetching: ${url}`);
        
        const response = await makeRequest(url, {
            headers: {
                'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
            }
        });
        
        console.log(`[VidsrcCC] Response status: ${response.status}`);
        console.log(`[VidsrcCC] Response length: ${response.data.length}`);
        console.log(`[VidsrcCC] Full HTML:`, response.data);
        
        // Look for lightningbolt.site URLs in the response
        const lightningboltMatches = response.data.match(/https:\/\/lightningbolt\.site\/[^"'\s]+/g);
        if (lightningboltMatches) {
            console.log(`[VidsrcCC] Found ${lightningboltMatches.length} lightningbolt.site URLs`);
            for (const url of lightningboltMatches) {
                streams.push({
                    url: url,
                    provider: 'VidsrcCC',
                    quality: 'HD',
                    headers: {
                        'Referer': BASE_URL,
                        'Origin': BASE_URL,
                        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
                    }
                });
                console.log(`[VidsrcCC] Added lightningbolt stream: ${url.substring(0, 100)}...`);
            }
        }
        
        // Also look for any other m3u8 URLs
        const m3u8Matches = response.data.match(/https[^"'\s]*\.m3u8[^"'\s]*/g);
        if (m3u8Matches) {
            console.log(`[VidsrcCC] Found ${m3u8Matches.length} m3u8 URLs`);
            for (const url of m3u8Matches) {
                streams.push({
                    url: url,
                    provider: 'VidsrcCC',
                    quality: 'HD',
                    headers: {
                        'Referer': BASE_URL,
                        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
                    }
                });
                console.log(`[VidsrcCC] Added m3u8 stream: ${url.substring(0, 100)}...`);
            }
        }
        
        const $ = cheerio.load(response.data);
        
        // Extract server options
        const serverItems = $('#servers .dropdown-item');
        console.log(`[VidsrcCC] Found ${serverItems.length} server items`);
        
        for (let i = 0; i < serverItems.length; i++) {
            const server = $(serverItems[i]);
            const serverName = server.text().trim();
            const dataHash = server.attr('data-hash');
            
            if (!dataHash) continue;
            
            console.log(`[VidsrcCC] Found server: ${serverName} with hash: ${dataHash.substring(0, 50)}...`);
            
            // Try to decode the hash
            const decodedHash = decodeVidsrcHash(dataHash);
            console.log(`[VidsrcCC] Decoded hash: ${decodedHash ? decodedHash.substring(0, 100) : 'null'}`);
            
            if (decodedHash) {
                let streamUrl = null;
                let provider = 'VidsrcCC';
                
                // Handle different server types
                if (serverName.toLowerCase().includes('vidplay')) {
                    if (decodedHash.startsWith('http')) {
                        streamUrl = await extractVidPlayUrl(decodedHash);
                        provider = 'VidPlay';
                    }
                } else if (serverName.toLowerCase().includes('upcloud')) {
                    if (decodedHash.startsWith('http')) {
                        streamUrl = await extractUpCloudUrl(decodedHash);
                        provider = 'UpCloud';
                    }
                } else if (serverName.toLowerCase().includes('gocloud')) {
                    // Similar to UpCloud
                    if (decodedHash.startsWith('http')) {
                        streamUrl = await extractUpCloudUrl(decodedHash);
                        provider = 'GoCloud';
                    }
                }
                
                if (streamUrl) {
                    streams.push({
                        url: streamUrl,
                        provider: provider,
                        quality: 'HD',
                        headers: {
                            'Referer': BASE_URL,
                            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
                        }
                    });
                    
                    console.log(`[VidsrcCC] Added ${provider} stream`);
                }
            }
        }
        
        console.log(`[VidsrcCC] Returning ${streams.length} streams`);
        return streams;
    } catch (e) {
        console.error('[VidsrcCC] Error:', e.message);
        console.error('[VidsrcCC] Error type:', e.constructor.name);
        if (e.code) {
            console.error('[VidsrcCC] Error code:', e.code);
        }
        if (e.response) {
            console.error('[VidsrcCC] Response status:', e.response.status);
            console.error('[VidsrcCC] Response headers:', e.response.headers);
        }
        console.error('[VidsrcCC] Stack:', e.stack);
        return [];
    }
}

module.exports = {
    getVidsrcStreams
};
