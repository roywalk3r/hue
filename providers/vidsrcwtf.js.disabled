const axios = require('axios');

const DOMAIN = 'https://vidsrc.wtf';
const API_DOMAIN = 'https://api.rgshows.me/main';
const USER_AGENT = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36';

async function getStreams(tmdbId, mediaType, season, episode) {
    console.log(`[VidSrcWtf] Processing: TMDB ${tmdbId} (${mediaType})`);
    
    let url;
    if (mediaType === 'movie') {
        url = `${API_DOMAIN}/movie/${tmdbId}`;
    } else {
        url = `${API_DOMAIN}/tv/${tmdbId}/${season}/${episode}`;
    }

    try {
        const response = await axios.get(url, {
            headers: {
                'Origin': DOMAIN,
                'Referer': DOMAIN,
                'User-Agent': USER_AGENT
            },
            timeout: 10000
        });

        const data = response.data;
        
        if (!data || !data.stream || !data.stream.url) {
            console.log('[VidSrcWtf] No stream URL found in response');
            return [];
        }

        return [{
            title: `VidSrcWtf - English - HLS`,
            url: data.stream.url,
            quality: 'Auto',
            provider: 'VidSrcWtf',
            headers: {
                'Referer': DOMAIN,
                'User-Agent': USER_AGENT
            }
        }];

    } catch (e) {
        console.error(`[VidSrcWtf] Error: ${e.message}`);
        return [];
    }
}

module.exports = { getStreams };
