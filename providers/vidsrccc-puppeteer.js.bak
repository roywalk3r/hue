const puppeteer = require("puppeteer-extra");
const StealthPlugin = require("puppeteer-extra-plugin-stealth");

// Use stealth plugin
puppeteer.use(StealthPlugin());

const BASE_URL = "https://vidsrc.cc";

// Main function to get streams using Puppeteer
async function getVidsrcStreams(tmdbId, mediaType, season, episode) {
    console.log(`[VidsrcCC] Called with tmdbId=${tmdbId}, mediaType=${mediaType}`);
    const streams = [];
    let browser;
    
    try {
        // Build the URL
        let url;
        if (mediaType === "movie") {
            url = `${BASE_URL}/v2/embed/movie/${tmdbId}`;
        } else {
            url = `${BASE_URL}/v2/embed/tv/${tmdbId}/${season}/${episode}`;
        }
        
        console.log(`[VidsrcCC] Launching Puppeteer to fetch: ${url}`);
        
        // Launch browser with stealth settings
        browser = await puppeteer.launch({
            headless: true,
            args: [
                "--no-sandbox",
                "--disable-setuid-sandbox",
                "--disable-dev-shm-usage",
                "--disable-accelerated-2d-canvas",
                "--no-first-run",
                "--no-zygote",
                "--single-process",
                "--disable-gpu",
                "--disable-blink-features=AutomationControlled",
                "--disable-features=VizDisplayCompositor"
            ]
        });
        
        const page = await browser.newPage();
        
        // Hide webdriver
        await page.evaluateOnNewDocument(() => {
            Object.defineProperty(navigator, "webdriver", {
                get: () => undefined,
            });
        });
        
        // Set up request interception
        const lightningboltUrls = new Set();
        page.on("request", request => {
            const url = request.url();
            if (url.includes("lightningbolt.site")) {
                console.log(`[VidsrcCC] Found lightningbolt request: ${url}`);
                lightningboltUrls.add(url);
            }
        });
        
        page.on("response", response => {
            const url = response.url();
            if (url.includes("lightningbolt.site")) {
                console.log(`[VidsrcCC] Lightningbolt response status: ${response.status()}`);
            }
        });
        
        // Set user agent and other headers
        await page.setUserAgent("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36");
        await page.setExtraHTTPHeaders({
            "Accept-Language": "en-US,en;q=0.9",
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
            "Accept-Encoding": "gzip, deflate, br",
            "Connection": "keep-alive",
            "Upgrade-Insecure-Requests": "1"
        });
        
        // Navigate to the page
        console.log("[VidsrcCC] Navigating to page...");
        await page.goto(url, { 
            waitUntil: "networkidle2",
            timeout: 30000 
        });
        
        // Wait for content to load
        console.log("[VidsrcCC] Waiting for page to fully load...");
        await new Promise(resolve => setTimeout(resolve, 10000));
        
        // Check if we are on a Cloudflare challenge page
        const isCloudflarePage = await page.evaluate(() => {
            return document.title.includes("Just a moment") || 
                   document.body.innerHTML.includes("Cloudflare") ||
                   document.body.innerHTML.includes("ray_id");
        });
        
        if (isCloudflarePage) {
            console.log("[VidsrcCC] Cloudflare challenge detected, waiting longer...");
            await new Promise(resolve => setTimeout(resolve, 15000));
            
            // Check again
            const stillCloudflare = await page.evaluate(() => {
                return document.title.includes("Just a moment") || 
                       document.body.innerHTML.includes("ray_id");
            });
            
            if (stillCloudflare) {
                console.log("[VidsrcCC] Still on Cloudflare page, giving up");
                return [];
            }
        }
        
        // Get the HTML content
        const html = await page.content();
        console.log(`[VidsrcCC] Page loaded, HTML length: ${html.length}`);
        
        // Add the intercepted lightningbolt URLs to streams
        if (lightningboltUrls.size > 0) {
            console.log(`[VidsrcCC] Found ${lightningboltUrls.size} lightningbolt URLs via network interception`);
            for (const streamUrl of lightningboltUrls) {
                // Only include m3u8 streams, filter out tracking pixels
                if (streamUrl.includes(".m3u8")) {
                    streams.push({
                        url: streamUrl,
                        provider: "VidsrcCC",
                        quality: "HD",
                        headers: {
                            "Referer": BASE_URL,
                            "Origin": BASE_URL,
                            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"
                        }
                    });
                    console.log(`[VidsrcCC] Added lightningbolt stream: ${streamUrl.substring(0, 100)}...`);
                }
            }
        }
        
        console.log(`[VidsrcCC] Returning ${streams.length} streams`);
        return streams;
        
    } catch (e) {
        console.error("[VidsrcCC] Error:", e.message);
        console.error("[VidsrcCC] Stack:", e.stack);
        return [];
    } finally {
        if (browser) {
            await browser.close();
        }
    }
}

module.exports = {
    getVidsrcStreams
};
